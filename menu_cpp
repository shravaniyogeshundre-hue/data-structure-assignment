#include <iostream>
using namespace std;

void restaurantMenu()
{
    int choice;

    cout << "\n===== RESTAURANT MENU =====" << endl;
    cout << "1. Pizza" << endl;
    cout << "2. Burger" << endl;
    cout << "3. Pasta" << endl;
    cout << "4. Exit" << endl;

    cout << "Enter your choice: ";
    cin >> choice;

    switch (choice)
    {
        case 1:
            cout << "You selected Pizza." << endl;
            break;

        case 2:
            cout << "You selected Burger." << endl;
            break;

        case 3:
            cout << "You selected Pasta." << endl;
            break;

        case 4:
            cout << "Thank you! Exiting..." << endl;
            return;

        default:
            cout << "Invalid choice!" << endl;
    }

    // Recursive call
    restaurantMenu();
}

int main()
{
    restaurantMenu();
    return 0;
}
