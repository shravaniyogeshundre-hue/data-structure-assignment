#include <iostream>
using namespace std;

int main()
{
    int queue[5];
    int front = 0, rear = -1;

    cout << "Enter 5 customer numbers:" << endl;

    for(int i = 0; i < 5; i++)
    {
        cin >> queue[++rear];
    }

    cout << "\nCustomers will be served in this order:" << endl;

    while(front <= rear)
    {
        cout << queue[front] << endl;
        front++;
    }

    return 0;
}
